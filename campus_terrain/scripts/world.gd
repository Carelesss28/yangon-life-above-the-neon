extends Node3D
## Seaside cozy-cyberpunk town. The map itself is built by seaside_town.gd from the plan data in
## terrain_layout.gd / road_layout.gd / reference_blocks.gd (generated by tools/seaside_plan.py).
## This script owns materials, lighting, the HUD, controls and the shared geometry helpers.

const Layout = preload("res://scripts/terrain_layout.gd")
const Player = preload("res://scripts/player.gd")
const FollowCamera = preload("res://scripts/follow_camera.gd")
const DressingClearance = preload("res://scripts/dressing_clearance.gd")
const SPAWN := Vector2(693.66,646)
var player: CharacterBody3D
var camera: Camera3D
var sun: DirectionalLight3D
var environment: Environment
var sky_material: ProceduralSkyMaterial
var night: bool = false
var time_mode: int = 1          # 0 day, 1 dusk, 2 night
var labels: Array[Label3D] = []
var lamps: Array[Light3D] = []
var status: Label
var overview_button: Button
var night_button: Button
var rng = RandomNumberGenerator.new()
var mats: Dictionary = {}
var elapsed: float = 0.0
var grass_exclusions: Array=[]
var shop_fronts: Array=[]   # {node, width, front, open} shophouse units, dressed by street_life
var paved_areas: Array=[]   # [Rect2, title] of open paved walks and plazas, dressed by street_life
