func _lighting() -> void:
	var world_environment = WorldEnvironment.new()
	environment = Environment.new()
	environment.background_mode = Environment.BG_SKY
	var sky=Sky.new()
	sky_material=ProceduralSkyMaterial.new()
	sky.sky_material=sky_material
	environment.sky=sky
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	environment.glow_enabled=true
	environment.glow_intensity=0.7
	environment.glow_bloom=0.08
	environment.ssao_enabled=true
	environment.ssao_radius=1.5
	environment.ssao_intensity=0.55
	environment.ssr_enabled=true
	environment.fog_enabled=true
	environment.fog_density=0.00012
	environment.fog_sky_affect=0.0
	environment.adjustment_enabled=true
	environment.adjustment_saturation=1.12
	world_environment.environment = environment
	add_child(world_environment)
	sun = DirectionalLight3D.new()
	sun.name = "Sun"
	sun.shadow_enabled = true
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
	sun.directional_shadow_max_distance = 130
	add_child(sun)

func _apply_time() -> void:
	night = time_mode >= 1
	match time_mode:
		0:
			sun.rotation_degrees = Vector3(-50, -30, 0)
			sun.light_color = Color("fff1d6")
			sun.light_energy = 1.35
			sky_material.sky_top_color = Color("5d9fdc")
			sky_material.sky_horizon_color = Color("cfe6ee")
			sky_material.ground_horizon_color = Color("cfe6ee")
			environment.ambient_light_color = Color("b9cfd4")
			environment.ambient_light_energy = 0.62
			environment.fog_light_color = Color("a9c6d0")
		1:
			# Dusk: low orange sun, violet zenith, long cel shadows; street lights come on.
			sun.rotation_degrees = Vector3(-14, -62, 0)
			sun.light_color = Color("ff9a5c")
			sun.light_energy = 1.05
			sky_material.sky_top_color = Color("3b2e6e")
			sky_material.sky_horizon_color = Color("f08a5d")
			sky_material.ground_horizon_color = Color("e7895f")
			environment.ambient_light_color = Color("9a8ab8")
			environment.ambient_light_energy = 0.5
			environment.fog_light_color = Color("c07a6a")
		2:
			sun.rotation_degrees = Vector3(-55, -28, 0)
			sun.light_color = Color("7d97d6")
			sun.light_energy = 0.22
			sky_material.sky_top_color = Color("0f1330")
			sky_material.sky_horizon_color = Color("2b2c5a")
			sky_material.ground_horizon_color = Color("2b2c5a")
			environment.ambient_light_color = Color("7f88c8")
			environment.ambient_light_energy = 0.36
			environment.fog_light_color = Color("241f4a")
	var lamp_scale = 0.0 if time_mode == 0 else (0.75 if time_mode == 1 else 1.0)
	for light in lamps:
		if is_instance_valid(light): light.light_energy = float(light.get_meta("night_energy",1.0))*lamp_scale
	if city_lighting: city_lighting.apply_mode(night)
	if street_life: street_life.apply_mode(night)
	if shophouses: shophouses.apply_mode(night)
	if skyline: skyline.apply_mode(night)
	if traffic: traffic.apply_mode(night)
	if night_button: night_button.text = ["Day","Dusk","Night"][time_mode] + "  [N]"

func toggle_night() -> void:
	time_mode = (time_mode + 1) % 3
	_apply_time()

func _outline_pass() -> void:
	# Screen-space ink lines from depth and normals, faded with distance (anime render layer).
	outline = MeshInstance3D.new()
	outline.name = "InkOutlinePass"
	var quad = QuadMesh.new()
	quad.size = Vector2(2, 2)
	outline.mesh = quad
	var material = ShaderMaterial.new()
	material.shader = load("res://shaders/outline_post.gdshader")
	outline.material_override = material
	outline.extra_cull_margin = 16384
	outline.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	camera.add_child(outline)

# ---------------------------------------------------------------- geometry helpers
func _mesh_node(mesh: Mesh, material: Material, node_name: String, solid: bool = false) -> MeshInstance3D:
	var instance = MeshInstance3D.new()
	instance.name = node_name
	if node_name in ["DistrictLake","Reservoir","CampusPond"]: mesh=_wave_disk()
	instance.mesh = mesh
	instance.material_override = material
	if material==mats.water:
		instance.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		instance.material_override=material.duplicate()
		if node_name=="Sea":
			instance.material_override.set_shader_parameter("water_kind",1)
			instance.material_override.set_shader_parameter("flow_speed",0.05)
			instance.material_override.set_shader_parameter("wave_height",0.03)
		else:
			instance.material_override.set_shader_parameter("flow_speed",0.045)
			instance.material_override.set_shader_parameter("wave_height",0.022)
			instance.material_override.set_shader_parameter("water_kind",2)
	add_child(instance)
	if solid:
		var body = StaticBody3D.new()
		var collision = CollisionShape3D.new()
		collision.shape = mesh.create_trimesh_shape()
		body.add_child(collision)
		instance.add_child(body)
	return instance

func _box(at: Vector3, size: Vector3, material: Material, node_name: String = "Detail", solid: bool = false) -> MeshInstance3D:
	var mesh = BoxMesh.new()
	mesh.size = size
	var instance = _mesh_node(mesh, material, node_name)
	instance.position = at
	if solid:
		var body = StaticBody3D.new()
		var collision = CollisionShape3D.new()
		var shape = BoxShape3D.new()
		shape.size = size
		collision.shape = shape
		body.add_child(collision)
		instance.add_child(body)
	return instance

func _cylinder(at: Vector3, radius: float, height: float, material: Material, node_name: String = "Detail") -> MeshInstance3D:
	var mesh = CylinderMesh.new()
	mesh.top_radius = radius
	mesh.bottom_radius = radius
	mesh.height = height
	mesh.radial_segments = 16
	var instance = _mesh_node(mesh, material, node_name)
	instance.position = at
	return instance

func _bar(a: Vector3, b: Vector3, radius: float, material: Material) -> void:
	if a.distance_to(b) < 0.001:
		return
	var instance = _cylinder((a + b) * 0.5, radius, a.distance_to(b), material, "Rail")
	var axis = (b - a).normalized()
	var reference = Vector3.RIGHT if absf(axis.dot(Vector3.FORWARD)) > 0.95 else Vector3.FORWARD
	var right = axis.cross(reference).normalized()
	instance.basis = Basis(right, axis, right.cross(axis)).orthonormalized()

func _surface(rect: Rect2, material: Material, node_name: String, solid: bool, height_function: Callable, step: float = 1.0, skip_water: bool = false) -> MeshInstance3D:
	if material!=mats.grass and material!=mats.water:
		grass_exclusions.append(rect.grow(0.35))
	var st = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var xs: Array[float] = []
	var zs: Array[float] = []
	for i in range(ceili(rect.size.x / step) + 1): xs.append(minf(rect.position.x + i * step, rect.end.x))
	for j in range(ceili(rect.size.y / step) + 1): zs.append(minf(rect.position.y + j * step, rect.end.y))
	var any=false
	for ix in range(xs.size() - 1):
		for iz in range(zs.size() - 1):
			var x = xs[ix]
			var z = zs[iz]
			var xx = xs[ix + 1]
			var zz = zs[iz + 1]
			if skip_water and Layout.wet((x + xx) * 0.5, (z + zz) * 0.5): continue
			var a = Vector3(x, height_function.call(x, z), z)
			var b = Vector3(xx, height_function.call(xx, z), z)
			var c = Vector3(x, height_function.call(x, zz), zz)
			var e = Vector3(xx, height_function.call(xx, zz), zz)
			for point in [a, b, c, b, e, c]:
				st.set_uv(Vector2(point.x, point.z) / 4.0)
				st.add_vertex(point)
			any=true
	if not any: return null
	st.generate_normals()
	st.index()
	return _mesh_node(st.commit(), material, node_name, solid)

func _inside_stair(_x: float, _z: float) -> bool:
	return false

func _bench(x: float, z: float) -> void:
	downloaded_props.bench(x,z)
	activity_spots.append({"pos":Vector3(x,Layout.height_at(x,z),z),"title":"BENCH"})

func _lamp(x: float, z: float) -> void:
	if dressing_clearance==null:
		pending_path_lamps.append(Vector2(x,z))
		return
	var h = Layout.height_at(x, z)
	if not dressing_clearance.reserve(Vector2(x,z),0.30,"lamp"): return
	_cylinder(Vector3(x, h + 1.4, z), 0.08, 2.8, mats.metal, "PathLight")
	_box(Vector3(x, h + 1.4, z), Vector3(0.3, 2.8, 0.3), mats.metal, "PathLightSolid", true).visible = false
	var emitter=_box(Vector3(x, h + 2.8, z), Vector3(0.35, 0.22, 0.35), mats.amber, "WarmLamp")
	emitter.add_to_group("city_lamp_emitters")
	var light = OmniLight3D.new()
	light.position = Vector3(x, h + 2.55, z)
	light.light_color = Color("ffca8b")
	light.omni_range = 7
	light.light_energy = 1.5 if night else 0.0
	light.set_meta("night_energy",1.5)
	add_child(light)
	lamps.append(light)

func _label(value: String, at: Vector3) -> void:
	var label = Label3D.new()
	label.text = value
	label.position = at
	label.font_size = 40
	label.pixel_size = 0.025
	label.modulate = Color("d9f6e7")
	label.outline_modulate = Color("17383e")
	label.outline_size = 9
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.visible = false
	add_child(label)
	labels.append(label)

func _scene_bounds(node: Node3D, parent_transform: Transform3D = Transform3D.IDENTITY) -> AABB:
	var transform = parent_transform * node.transform
	var bounds = AABB()
	if node is MeshInstance3D and node.mesh:
		bounds = transform * node.get_aabb()
	for child in node.get_children():
		if child is Node3D:
			var child_bounds = _scene_bounds(child, transform)
			if child_bounds.size.length() > 0:
				bounds = child_bounds if bounds.size.length() == 0 else bounds.merge(child_bounds)
	return bounds

func _wave_disk() -> ArrayMesh:
	var st=SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for ring in range(24):
		for segment in range(96):
			var r=float(ring)/24
			var rr=float(ring+1)/24
			var a=TAU*segment/96
			var b=TAU*(segment+1)/96
			var points=[Vector3(cos(a)*r,0,sin(a)*r),Vector3(cos(b)*r,0,sin(b)*r),Vector3(cos(a)*rr,0,sin(a)*rr),Vector3(cos(b)*rr,0,sin(b)*rr)]
			for i in [0,2,1,1,2,3]:
				var v=points[i]
				st.set_color(Color(1-smoothstep(0.82,1,v.length()),1,1,1))
				st.set_normal(Vector3.UP)
				st.set_uv(Vector2(v.x,v.z)*0.5+Vector2.ONE*0.5)
				st.add_vertex(v)
	return st.commit()

# ---------------------------------------------------------------- camera, visits, HUD
func toggle_overview() -> void:
	if player.transit_mode: return
	if interiors and (interiors.inside or interiors.busy): return
	if camera.masterplan:
		close_maps()
		return
	camera.overview = not camera.overview
	camera.masterplan = false
	camera.instant = true
	_map_ui()

func close_maps() -> void:
	# Every way out of the map views lands back on the walking camera.
	camera.overview = false
	camera.masterplan = false
	camera.target = player
	camera.instant = true
	_map_ui()

func _map_ui() -> void:
	var open = camera.overview or camera.masterplan
	overview_button.text = "Walk camera [Tab]" if open else "Whole map [Tab]"
	if map_hint: map_hint.visible = open

func toggle_masterplan() -> void:
	if player.transit_mode: return
	if interiors and (interiors.inside or interiors.busy): return
	camera.masterplan = not camera.masterplan
	camera.overview = false
	camera.instant = true
	_map_ui()

func visit_section(index: int) -> void:
	if player.transit_mode: return
	if interiors and (interiors.inside or interiors.busy): return
	var at=Layout.DISTRICT_VISITS[index]
	player.teleport(Vector3(at.x,Layout.height_at(at.x,at.y)+0.15,at.y))
	close_maps()
	if index in [7,8]:
		camera.reset_orbit()
		camera.zoom=1.55
		camera.pitch=deg_to_rad(52.0)
	if index==8:
		camera.yaw=0.0
		camera.zoom=1.7

func _unhandled_key_input(event: InputEvent) -> void:
	if not event is InputEventKey or not event.pressed or event.echo: return
	if player.transit_mode and event.physical_keycode not in [KEY_ESCAPE,KEY_N]: return
	if interiors and interiors.busy: return
	if interiors and interiors.inside and event.physical_keycode not in [KEY_ESCAPE,KEY_N,KEY_R]: return
	match event.physical_keycode:
		KEY_TAB: toggle_overview()
		KEY_N: toggle_night()
		KEY_M: toggle_masterplan()
		KEY_1: visit_section(0)
		KEY_2: visit_section(1)
		KEY_3: visit_section(2)
		KEY_4: visit_section(3)
		KEY_5: visit_section(4)
		KEY_6: visit_section(5)
		KEY_7: visit_section(6)
		KEY_8: visit_section(7)
		KEY_9: visit_section(8)   # YUST mecha hangar: the four pilotable frames
		KEY_O: if outline: outline.visible = not outline.visible
		KEY_R: player.teleport(player.last_safe); camera.instant = true
		KEY_F2:
			for label in labels: label.visible = not label.visible
		KEY_ESCAPE:
			if camera.overview or camera.masterplan: close_maps()
			else: player.paused = not player.paused

func _button(value: String, parent: Node, action: Callable) -> Button:
	var button = Button.new()
	button.text = value
	button.add_theme_font_size_override("font_size", 12)
	button.custom_minimum_size.y = 38
	button.pressed.connect(action)
	button.focus_mode = Control.FOCUS_NONE
	parent.add_child(button)
	return button

