func _process(delta: float) -> void:
	if hangar_roof and player:
		hangar_roof.visible=player.global_position.distance_squared_to(hangar_roof.global_position)>1600.0
	var moving=Input.is_physical_key_pressed(KEY_W) or Input.is_physical_key_pressed(KEY_A) or Input.is_physical_key_pressed(KEY_S) or Input.is_physical_key_pressed(KEY_D)
	if camera and (camera.overview or camera.masterplan) and moving and not player.transit_mode: close_maps()
	if camera and player and camera.target!=player and (not interiors or not interiors.inside) and (Input.is_physical_key_pressed(KEY_W) or Input.is_physical_key_pressed(KEY_A) or Input.is_physical_key_pressed(KEY_S) or Input.is_physical_key_pressed(KEY_D)):
		camera.target=player
		camera.instant=true
	elapsed += delta
	if status and player:
		var index = 0
		var nearest = INF
		for i in range(Layout.DISTRICT_VISITS.size()):
			var distance = Vector2(player.position.x,player.position.z).distance_to(Layout.DISTRICT_VISITS[i])
			if distance < nearest:
				nearest=distance
				index=i
		status.text = "%s\nGROUND %.1f m%s" % [Layout.DISTRICT_NAMES[index], player.position.y, "  |  PAUSED" if player.paused else ""]

# ---------------------------------------------------------------- captures and quit
func _town_capture() -> void:
	player.paused=true
	get_window().size=Vector2i(1440,900)
	for child in get_children():
		if child is CanvasLayer and not (minimap and minimap.get_parent()==child): child.visible=false
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://screenshots"))
	var only=""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--only="): only=arg.substr(7)
	var modes=[1] if only=="" else [int(only)]
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--view="):
			# --view=x,z,zoom,mode,name : one framed shot for reviews.
			var v=arg.substr(7).split(",")
			time_mode=int(v[3])
			_apply_time()
			player.teleport(Vector3(float(v[0]),Layout.height_at(float(v[0]),float(v[1]))+0.15,float(v[1])))
			camera.zoom=float(v[2])
			if v.size()>5: camera.pitch=deg_to_rad(float(v[5]))
			if v.size()>6: camera.yaw=deg_to_rad(float(v[6]))
			camera.instant=true
			for f in range(90): await get_tree().process_frame
			await RenderingServer.frame_post_draw
			get_viewport().get_texture().get_image().save_png("res://screenshots/view_%s.png" % v[4])
			print("VIEW_SAVED ",v[4])
			await _quit_cleanly()
			return
	if "--all-times" in OS.get_cmdline_user_args(): modes=[0,1,2]
	for mode in modes:
		time_mode=mode
		_apply_time()
		var tag=["day","dusk","night"][mode]
		camera.overview=true
		camera.instant=true
		for i in range(40): await get_tree().process_frame
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("res://screenshots/seaside_overview_%s.png" % tag)
		camera.overview=false
		for i in range(Layout.DISTRICT_VISITS.size()):
			var at: Vector2=Layout.DISTRICT_VISITS[i]
			player.teleport(Vector3(at.x,Layout.height_at(at.x,at.y)+0.15,at.y))
			camera.zoom=1.25
			camera.instant=true
			for f in range(70): await get_tree().process_frame
			await RenderingServer.frame_post_draw
			get_viewport().get_texture().get_image().save_png("res://screenshots/seaside_%d_%s_%s.png" % [i,Layout.DISTRICT_SHORT[i].to_lower().replace(" ","_"),tag])
	print("TOWN_CAPTURE_COMPLETE")
	await _quit_cleanly()

func _vehicle_review() -> void:
	# Lines every road model up on the campus walk, all set to "drive" toward -Z (up the screen).
	player.paused=true
	for child in get_children():
		if child is CanvasLayer: child.visible=false
	time_mode=0
	_apply_time()
	var names=traffic.CARS+traffic.BIKES
	for i in range(names.size()):
		var inst=traffic.make_model(names[i])
		var x=309.86+i*6.0
		inst.position=Vector3(x,Layout.PROMENADE_Y+0.1,212)
		add_child(inst)
		_box(Vector3(x,Layout.PROMENADE_Y+0.1,205),Vector3(0.3,0.1,3.0),mats.hazard,"ForwardArrow")
	var px=float(OS.get_environment("VR_X")) if OS.get_environment("VR_X")!="" else 475.0
	player.teleport(Vector3(px,Layout.PROMENADE_Y+0.2,221))
	camera.zoom=float(OS.get_environment("VR_ZOOM")) if OS.get_environment("VR_ZOOM")!="" else 1.1
	camera.pitch=deg_to_rad(float(OS.get_environment("VR_PITCH")) if OS.get_environment("VR_PITCH")!="" else 55.0)
	if OS.get_environment("VR_YAW")!="": camera.yaw=deg_to_rad(float(OS.get_environment("VR_YAW")))
	camera.instant=true
	for f in range(90): await get_tree().process_frame
	await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png("res://screenshots/view_vehicle_review.png")
	print("VIEW_SAVED vehicle_review")
	await _quit_cleanly()

func _quit_cleanly() -> void:
	if quitting: return
	quitting=true
	if breeze and DisplayServer.get_name()!="headless":
		breeze.release_visuals()
		for i in range(3):
			await get_tree().process_frame
			await RenderingServer.frame_post_draw
	get_tree().quit()

func _notification(what: int) -> void:
	if what==NOTIFICATION_WM_CLOSE_REQUEST: _quit_cleanly()
