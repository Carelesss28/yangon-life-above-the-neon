func _ready() -> void:
	rng.seed = 20261119
	_materials()
	downloaded_props.setup(self)
	_lighting()
	town=load("res://scripts/seaside_town.gd").new()
	town.setup(self)
	town.build_before_buildings()
	skyline=load("res://scripts/skyline.gd").new()
	skyline.setup(self)
	load("res://scripts/reference_buildings.gd").new().setup(self)
	town.build_after_buildings()
	hill=load("res://scripts/hill_attractions.gd").new()
	hill.setup(self)
	shophouses=load("res://scripts/shophouses.gd").new()
	shophouses.setup(self)
	skyline.after_buildings()
	var water_network=load("res://scripts/water_network.gd").new()
	water_network.world=self
	add_child(water_network)
	player = Player.new()
	player.name = "Student"
	add_child(player)
	player.teleport(Vector3(SPAWN.x, Layout.height_at(SPAWN.x,SPAWN.y)+0.15, SPAWN.y))
	camera = FollowCamera.new()
	camera.name = "HighCamera"
	camera.target = player
	add_child(camera)
	player.camera = camera
	_outline_pass()
	_hud()
	interiors=load("res://scripts/building_interiors.gd").new()
	interiors.world=self
	add_child(interiors)
	wildlife=load("res://scripts/wildlife.gd").new()
	wildlife.world=self
	add_child(wildlife)
	breeze=load("res://scripts/town_breeze.gd").new()
	breeze.world=self
	skytrain=load("res://scripts/skytrain.gd").new()
	skytrain.world=self
	add_child(skytrain)
	buses=load("res://scripts/bus_service.gd").new()
	buses.world=self
	add_child(buses)
	if "--no-traffic" not in OS.get_cmdline_user_args():
		traffic=load("res://scripts/traffic.gd").new()
		traffic.world=self
		add_child(traffic)
	load("res://scripts/services.gd").new().setup(self)
	garage=load("res://scripts/motor_district.gd").new()
	garage.world=self
	add_child(garage)
	rides=load("res://scripts/rides.gd").new()
	rides.world=self
	add_child(rides)
	click_move=load("res://scripts/click_move.gd").new()
	click_move.world=self
	add_child(click_move)
	dressing_clearance=DressingClearance.new()
	dressing_clearance.setup(self)
	town.build_late()
	load("res://scripts/district_fountains.gd").new().setup(self)
	for p in pending_path_lamps: _lamp(p.x,p.y)
	pending_path_lamps.clear()
	load("res://scripts/masterplan_dressing.gd").new().setup(self)
	if "--no-street-life" not in OS.get_cmdline_user_args():
		street_life=load("res://scripts/street_life.gd").new()
		street_life.setup(self)
	add_child(breeze)
	if DisplayServer.get_name()!="headless":
		grass_system=load("res://scripts/grass_system.gd").new()
		grass_system.target=player
		grass_system.camera=camera
		grass_system.excluded_rects=grass_exclusions
		grass_system.excluded_routes=grass_routes
		add_child(grass_system)
	city_lighting=load("res://scripts/city_lighting.gd").new()
	city_lighting.world=self
	add_child(city_lighting)
	_apply_time()
	if "--no-npcs" not in OS.get_cmdline_user_args():
		npcs=load("res://scripts/npc_system.gd").new()
		npcs.world=self
		add_child(npcs)
	if DisplayServer.get_name()!="headless":
		var map_layer=CanvasLayer.new()
		map_layer.layer=20
		add_child(map_layer)
		minimap=load("res://scripts/minimap.gd").new()
		minimap.world=self
		map_layer.add_child(minimap)
		# Anchor to the top-right corner: 22 px from the right edge, below the top bar.
		minimap.anchor_left=1.0
		minimap.anchor_right=1.0
		minimap.offset_left=-252
		minimap.offset_right=-22
		minimap.offset_top=92
		minimap.offset_bottom=322
		# Zoom buttons under the minimap (click or tap; also +/- keys, pinch and two-finger swipe).
		var zoom_row=HBoxContainer.new()
		zoom_row.anchor_left=1.0
		zoom_row.anchor_right=1.0
		zoom_row.offset_left=-252
		zoom_row.offset_right=-22
		zoom_row.offset_top=392
		zoom_row.add_theme_constant_override("separation",6)
		map_layer.add_child(zoom_row)
		for spec in [["Zoom in  +",-0.2],["Zoom out  -",0.2]]:
			var b=Button.new()
			b.text=spec[0]
			b.focus_mode=Control.FOCUS_NONE
			b.size_flags_horizontal=Control.SIZE_EXPAND_FILL
			b.custom_minimum_size.y=34
			b.pressed.connect(camera.zoom_by.bind(spec[1]))
			zoom_row.add_child(b)
	var args = OS.get_cmdline_user_args()
	# Merge static geometry: tens of thousands of small boxes become a few meshes per building.
	if "--no-batch" not in args: load("res://scripts/static_batcher.gd").run(self)
	if "--vehicle-review" in args: _vehicle_review()
	elif "--town-capture" in args: _town_capture()
	elif "--street-capture" in args: _town_capture()
	if DisplayServer.get_name()!="headless": get_tree().auto_accept_quit=false
	print("TERRAIN_READY: seaside town ",Layout.WORLD)

# ---------------------------------------------------------------- materials and light
func _mat(colour: String, roughness: float = 0.8, emission: float = 0.0) -> StandardMaterial3D:
	var material = StandardMaterial3D.new()
	material.albedo_color = Color(colour)
	material.roughness = roughness
	# Anime render layer: banded (cel) diffuse and a crisp specular highlight.
	material.diffuse_mode = BaseMaterial3D.DIFFUSE_TOON
	material.specular_mode = BaseMaterial3D.SPECULAR_TOON
	if emission > 0:
		material.emission_enabled = true
		material.emission = Color(colour)
		material.emission_energy_multiplier = emission
	return material

func _materials() -> void:
	mats.concrete = _mat("c9cfc8")
	mats.coping = _mat("eae6d6")
	mats.metal = _mat("3e626b", 0.45)
	mats.wood = _mat("b48a5e")
	mats.dark_wood = _mat("6c5945")
	mats.rock = _mat("8a948a")
	mats.leaf = _mat("5f9a55")
	mats.flower = _mat("e6b24f")
	mats.pink = _mat("e08aa2")
	mats.cyan = _mat("64c7c4", 0.4, 0.45)
	mats.amber = _mat("ffd79b", 0.5, 0.6)
	mats.road = _mat("4a5058", 0.9)
	mats.paint = _mat("f1efe4", 0.7)
	mats.yellow_paint = _mat("f2c24a", 0.7)
	mats.sand = _mat("e8d7a6", 0.95)
	mats.promenade = _mat("d9cdb5", 0.85)
	mats.curb = _mat("b9bcb4", 0.85)
	mats.hazard = _mat("f0b429", 0.6)
	mats.hazard_dark = _mat("2a2a2e", 0.6)
	var grass=ShaderMaterial.new()
	grass.shader=load("res://shaders/ground_grass.gdshader")
	mats.grass=grass
	var paving = ShaderMaterial.new()
	paving.shader = load("res://shaders/town_paving.gdshader")
