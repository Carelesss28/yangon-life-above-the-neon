extends RefCounted
## Seaside town terrain (metres). North (z=0) is the sea; the town climbs south into the hills.
## Plan data (roads, plots) is generated by tools/seaside_plan.py; heights live here.
const Roads=preload("res://scripts/road_layout.gd")

## The town was laid out at 1420 x 1000 m and squeezed east-west to 1000 x 1000 m (KX) for a denser,
## cozier town (2026-11-20). Height formulas keep their original "design" coordinates (D_*) and are
## evaluated at (x/KX, z/KZ); everything public is in world metres. Object sizes were not scaled.
const KX := 1000.0/1420.0
const KZ := 1.0
const WORLD := Rect2(0,0,1000,1000)
const MOTOR := Rect2(852.11,620,140.85,200)
const SEA_Y := -1.0
const RIVER_WATER_Y := SEA_Y   # older scripts read this name for the main water level
const PROMENADE_Y := 2.5
const DOWNTOWN_Y := 4.0
const PLATEAU_Y := 6.0
const RESERVOIR := Vector4(147.89,700,38.73,40)   # centre x, centre z, radius x, radius z
const RESERVOIR_Y := 17.0
const POND := Vector4(739.44,760,21.13,22)
const POND_Y := 5.0
const HARBOUR_X := Vector2(598.59,809.86)        # quay walls instead of beach between these x
const CAMPUS := Rect2(583.1,568,226.76,347)
const HILLS := Rect2(0,575,309.86,425)
const D_RESERVOIR := Vector4(210,700,55,40)
const D_POND := Vector4(1050,760,30,22)

const DISTRICT_VISITS = [Vector2(693.66,646),Vector2(394.37,313),Vector2(176.06,430),Vector2(295.77,190),Vector2(661.97,200),Vector2(441.55,740),Vector2(200.7,712),Vector2(679.58,768),Vector2(737.7,811)]
const DISTRICT_NAMES = ["YUST CAMPUS","DOWNTOWN / CANAL","HOME TERRACES","SEAFRONT PROMENADE","HARBOUR","MARKET HALLS","HILL PARK / RESERVOIR","MECHA LAUNCH BAY","YUST MECHA HANGAR"]
const DISTRICT_SHORT = ["Campus","Downtown","Home","Seafront","Harbour","Market","Hills","Launch bay","Mecha"]

# Hill park trails (walking only), used by grass, lighting and dressing.
const HILL_TRAIL = [Vector2(169.01,560),Vector2(144.37,600),Vector2(119.72,650),Vector2(98.59,700),Vector2(105.63,760),Vector2(140.85,770),Vector2(183.1,745),Vector2(193.66,700),Vector2(179.58,655)]
const TRAILS = [HILL_TRAIL]

static func shore(x: float) -> float:
	var d=x/KX
	return KZ*(185.0+14.0*sin(d*0.009)+8.0*sin(d*0.023+1.0))

static func harbour_weight(x: float) -> float:
	return smoothstep(HARBOUR_X.x-25,HARBOUR_X.x+10,x)*(1.0-smoothstep(HARBOUR_X.y-10,HARBOUR_X.y+25,x))

static func ellipse(x: float,z: float,e: Vector4) -> float:
	return Vector2((x-e.x)/e.z,(z-e.y)/e.w).length()

static func hill_rise(x: float,z: float) -> float:
	# Design coordinates.
	var rise=31.0*smoothstep(575.0,820.0,z)*(0.78+0.22*sin(x*0.021+0.6))
	rise+=5.5*sin(x*0.031+z*0.017)*sin(z*0.023)*smoothstep(575.0,650.0,z)
	return rise

# Flat platforms cut into the hills for the attractions: centre x, centre z, flat radius (world metres).
const HILL_PADS = [Vector3(260.56,900,40),Vector3(105.63,950,42),Vector3(179.58,875,26),Vector3(77.46,640,32),Vector3(66.9,760,22),Vector3(394.37,968,24)]
const PAD_BLEND := 14.0

static func town_height(x: float,z: float) -> float:
	var h=raw_town_height(x,z)
	for pad in HILL_PADS:
		var d=Vector2(x-pad.x,z-pad.y).length()
		if d<pad.z+PAD_BLEND:
			h=lerpf(raw_town_height(pad.x,pad.y),h,smoothstep(pad.z,pad.z+PAD_BLEND,d))
	return h

static func pad_height(i: int) -> float:
	var pad: Vector3=HILL_PADS[i]
	return raw_town_height(pad.x,pad.y)

static func raw_town_height(x: float,z: float) -> float:
	return _design_height(x/KX,z/KZ)

static func _design_height(x: float,z: float) -> float:
	# Promenade and coastal boulevard, then a gentle rise into the town.
	var h=lerpf(PROMENADE_Y,DOWNTOWN_Y,smoothstep(245.0,300.0,z))
	if z>300.0:
		var east=lerpf(DOWNTOWN_Y,PLATEAU_Y,smoothstep(540.0,580.0,z))
		var home=DOWNTOWN_Y+6.0*clampf((z-300.0)/240.0,0.0,1.0)
		h=lerpf(east,home,1.0-smoothstep(395.0,425.0,x))
	# Hill country to the south-west; the home terraces rise into it.
	if z>555.0:
		var hill=10.0+hill_rise(x,z)
		var w=(1.0-smoothstep(400.0,446.0,x))*smoothstep(555.0,585.0,z)
		h=lerpf(h,hill,w)
	# Edge ridges frame the bowl: west, south and east.
	h+=16.0*(1.0-smoothstep(0.0,48.0,x))*smoothstep(245.0,300.0,z)
	h+=24.0*smoothstep(930.0,995.0,z)
	h+=14.0*smoothstep(1377.0,1418.0,x)*smoothstep(245.0,300.0,z)*(1.0-smoothstep(560.0,600.0,z)*(1.0-smoothstep(830.0,870.0,z)))
	# Reservoir basin and campus pond.
	var r=ellipse(x,z,D_RESERVOIR)
	if r<1.3: h=lerpf(RESERVOIR_Y-4.0,h,smoothstep(0.82,1.3,r))
	var p=ellipse(x,z,D_POND)
	if p<1.25: h=lerpf(POND_Y-1.4,h,smoothstep(0.85,1.25,p))
	return h

static func natural_height_at(x: float,z: float) -> float:
	var s=shore(x)
	if z>=s: return town_height(x,z)
	var d=s-z
	var beach=lerpf(0.7,-1.9,smoothstep(1.5,34.0,d))-6.0*smoothstep(34.0,160.0,d)
	var quay=-5.5-2.0*smoothstep(0.0,120.0,d)
	var under=lerpf(beach,quay,harbour_weight(x))
	# A short sea wall drops from the promenade to the beach or the harbour water.
	if d<1.5: return lerpf(PROMENADE_Y,under,d/1.5)
	return under

static func wet(x: float,z: float) -> bool:
	if z<shore(x) and natural_height_at(x,z)<SEA_Y: return true
	if ellipse(x,z,RESERVOIR)<1.0: return true
	if ellipse(x,z,POND)<1.0: return true
	return false

static func in_world(x: float,z: float) -> bool:
	return WORLD.has_point(Vector2(x,z))

static func is_sea(x: float,z: float) -> bool:
	return z<shore(x)

static func trail_distance(point: Vector2, route: Array) -> float:
	var distance=INF
	for i in range(route.size()-1):
		var a: Vector2=route[i]
		var b: Vector2=route[i+1]
		var t=clampf((point-a).dot(b-a)/a.distance_squared_to(b),0,1)
		distance=minf(distance,point.distance_to(a.lerp(b,t)))
	return distance

static func clear_for_planting(x: float,z: float) -> bool:
	if not in_world(x,z) or wet(x,z) or z<shore(x)+3: return false
	if not channel_sample(x,z).is_empty(): return false
	return Roads.sample(x,z).is_empty()

# Canals: each route's water level only falls downstream. Width in metres.
const WATER_ROUTES = [
 {"name":"West canal: reservoir spillway to the sea","width":4.0,"points":[Vector3(144.37,16.6,662),Vector3(130.28,14.8,640),Vector3(114.08,12.0,605),Vector3(105.63,9.6,572),Vector3(105.63,9.0,540),Vector3(105.63,7.6,480),Vector3(105.63,6.0,400),Vector3(105.63,4.6,320),Vector3(105.63,3.2,290),Vector3(105.63,1.5,250),Vector3(105.63,-1.2,190)]},
 {"name":"Cross canal: home terraces to downtown","width":3.6,"points":[Vector3(105.63,9.0,540),Vector3(169.01,8.9,540),Vector3(273.24,8.6,540),Vector3(305.63,3.1,540),Vector3(366.2,3.0,540),Vector3(429.58,2.9,540)]},
 {"name":"Downtown canal to the sea","width":5.0,"points":[Vector3(429.58,2.9,540),Vector3(429.58,2.8,480),Vector3(429.58,2.7,400),Vector3(429.58,2.5,320),Vector3(429.58,1.6,280),Vector3(429.58,1.2,250),Vector3(429.58,-1.2,185)]},
 {"name":"East canal: campus pond to the harbour","width":4.0,"points":[Vector3(746.48,4.95,738),Vector3(760.56,4.8,680),Vector3(760.56,4.6,600),Vector3(760.56,3.7,560),Vector3(760.56,2.9,480),Vector3(760.56,2.8,400),Vector3(760.56,2.6,320),Vector3(760.56,1.6,280),Vector3(760.56,1.2,250),Vector3(760.56,-1.2,190)]},
]
static var water_segments: Dictionary={}
static func init_water_index() -> void:
	if not water_segments.is_empty(): return
	for route in WATER_ROUTES:
		for i in range(route.points.size()-1):
			var a: Vector3=route.points[i]
			var b: Vector3=route.points[i+1]
			var radius=route.width*0.5+1.2
			var rect=Rect2(Vector2(a.x,a.z),Vector2.ZERO).expand(Vector2(b.x,b.z)).grow(radius)
			var entry={"a":a,"b":b,"width":route.width}
			for xx in range(floori(rect.position.x/20),floori(rect.end.x/20)+1):
				for zz in range(floori(rect.position.y/20),floori(rect.end.y/20)+1):
					var key=Vector2i(xx,zz)
					if not water_segments.has(key): water_segments[key]=[]
					water_segments[key].append(entry)
static func channel_sample(x: float,z: float) -> Dictionary:
	init_water_index()
	var best={}
	var nearest=INF
	for entry in water_segments.get(Vector2i(floori(x/20),floori(z/20)),[]):
		var a=Vector2(entry.a.x,entry.a.z)
		var b=Vector2(entry.b.x,entry.b.z)
		var t=clampf((Vector2(x,z)-a).dot(b-a)/a.distance_squared_to(b),0,1)
		var d=Vector2(x,z).distance_to(a.lerp(b,t))
		if d<entry.width*0.5+0.8 and d<nearest:
			nearest=d
			best={"distance":d,"width":entry.width,"water_y":lerpf(entry.a.y,entry.b.y,t)}
	return best
static func height_at(x: float,z: float) -> float:
	var base=base_height_at(x,z)
	var channel=channel_sample(x,z)
	if channel.is_empty(): return base
	# Water cannot float above the ground. Covered sections handle higher terraces.
	var depth=base-channel.water_y
	if depth<0.15 or depth>2.3: return base
	var half=channel.width*0.5
	return lerpf(channel.water_y-0.6,base,smoothstep(half,half+0.8,channel.distance))

static func base_height_at(x: float,z: float) -> float:
	var ground=natural_height_at(x,z)
	var road=Roads.sample(x,z)
	if road.is_empty() or road.mountain:
		var pass_grade=Roads.mountain_sample(x,z)
		if not pass_grade.is_empty():
			var blend_width=clampf(8.0+absf(pass_grade.y-ground)*1.35,10.0,37.0)
			var shoulder=pass_grade.half+0.9
			var blend=smoothstep(shoulder,shoulder+blend_width,pass_grade.distance)
			return lerpf(pass_grade.y-0.16,ground,blend)
	if road.is_empty(): return ground
	# Roads sit flush: cut high ground and fill low ground under the carriageway and verge.
	return lerpf(road.y+0.10,ground,smoothstep(road.half,road.half+3.0,road.distance))
