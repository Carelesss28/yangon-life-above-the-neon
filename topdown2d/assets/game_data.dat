"],[11,-330,"cat"],[489,75,"cat2"],[575,442,"cat"],[485,-3,"cat2"],[138,-420,"cat"],[583,-578,"cat2"],[138,794,"cat"],[557,35,"cat2"],[359,192,"cat"],[407,-303,"cat2"],[390,427,"cat"],[45,-611,"cat2"],[313,-638,"cat"],[142,160,"cat"],[38,120,"cat2"],[232,88,"cat"],[270,225,"cat2"],[440,130,"cat"],[120,470,"cat2"]],"birdHomes":[[95,-431],[23,-322],[395,359],[461,430],[-129,808],[577,-385],[124,-592],[471,648],[79,-616],[334,-304],[144,381],[366,440],[294,-313],[266,44],[238,-339],[220,419],[572,-520],[402,-329],[428,-300],[526,443],[243,384],[473,-659],[540,778],[577,-504],[576,-525],[469,520],[100,140],[190,70],[60,230],[240,150],[150,100],[430,200],[120,400]],"stations":[{"id":"C1","name":"Campus North","x":150,"z":8,"line":"C"},{"id":"C2","name":"Tech Interchange","x":610,"z":150,"line":"C"},{"id":"C3","name":"Lake Gardens","x":610,"z":450,"line":"C"},{"id":"C4","name":"Riverfront","x":420,"z":616,"line":"C"},{"id":"C5","name":"Home Terraces","x":150,"z":616,"line":"C"},{"id":"C6","name":"YUST Gate","x":8,"z":270,"line":"C"},{"id":"M2","name":"Market South","x":535,"z":-425,"line":"M"},{"id":"M3","name":"Market Halls","x":535,"z":-600,"line":"M"}],"cityLine":[[8,8],[610,8],[610,616],[8,616]],"marketLine":[[610,150],[610,-425],[535,-425],[535,-600]],"ambient":{"day":["Morning! Have you eaten? Please eat.","Class starts soon. I forgot my notes again.","The skytrain is on time today. Rare!","Look, the cat is sunbathing on the bench.","My Frame practice went better. I only fell over once.","There is fresh mohinga at the commons. Go before it is gone."],"dusk":["The lamps are coming on. I love this hour.","Heading to the lake for tea and street snacks.","Did you see the pink palms by the quad? They hum when the wind blows.","Study group at the cafe tonight. Bring snacks."],"night":["Quiet night. Stars and neon, what more do you need?","There is an alert on the transit screens, but it is far outside the city. We are fine.","Careful on the stairs, the rail glows but the steps are dark.","The cafe stays open late. Come with us?"],"rain":["I can smell rain. Umbrellas out!"]},"names":["Ma Thida","Ko Zin","Aye Chan","Htet Htet","Min Khant","Su Su","Ko Pyae","Hnin Wai","Thura","Nandar","Phyo","Ei Mon","Kyaw Kyaw","Moe Moe"],"start":[150,169]}