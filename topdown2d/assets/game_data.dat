0.7]},{"k":"bench","x":545,"z":395,"coll":[1.8,0.7]}],"interiors":{"classroom":{"w":16,"d":11,"colliders":[[0,0,16,3],[6,3.6,4,1.2],[2.2,6,2,0.6],[5.4,6,2,0.6],[8.600000000000001,6,2,0.6],[11.8,6,2,0.6],[2.2,7.7,2,0.6],[5.4,7.7,2,0.6],[8.600000000000001,7.7,2,0.6],[11.8,7.7,2,0.6],[2.2,9.4,2,0.6],[5.4,9.4,2,0.6],[8.600000000000001,9.4,2,0.6],[11.8,9.4,2,0.6],[0.6,3.4,0.7,3],[14.4,3.4,0.9,0.9],[12,0.6,3.4,1.8]],"exit":[6.5,10.1,3,1.4],"spawn":[8,9.4],"npcs":[{"name":"Daw Mya Mya","skin":3,"role":"Teacher","lines":["Energy management today: slide the marker into the green zone. Easy. Take your time.","Missed a lesson? Come to the catch-up window on Friday. No grade is ever lost for being late."],"x":5,"z":4.7},{"name":"Hnin Wai","skin":0,"role":"Student","lines":["The engineering club is matching parts again. Come, it is like a puzzle with tea.","I heard there is an alert tonight. Do not worry, it is far outside the city."],"x":11.3,"z":4.7}]},"dorm":{"w":12,"d":9,"colliders":[[0,0,12,3],[1,3.4,2.2,3.2],[9,3.4,2.2,3.2],[4.6,3.3,3,1.1],[0.8,0.6,2.4,2.2],[8.8,0.8,2.4,1],[11,7,0.9,0.9]],"exit":[4.5,8.1,3,1.4],"spawn":[6,7.4],"npcs":[{"name":"Phyo","skin":2,"role":"Dorm resident","lines":["Rain on the window and a warm blanket. I am not coming out until class.","The cat from the quad likes this room. Do not tell the warden."],"x":5.9,"z":5.6}]},"cafe":{"w":15,"d":11,"colliders":[[0,0,15,3],[1,3.4,8,1.4],[1.4,3.1,0.7,0.7],[2,7,1.2,1.2],[1.1,7.2,0.55,0.55],[3.55,7.2,0.55,0.55],[6,6.4,1.2,1.2],[5.1,6.6000000000000005,0.55,0.55],[7.55,6.6000000000000005,0.55,0.55],[10,7,1.2,1.2],[9.1,7.2,0.55,0.55],[11.55,7.2,0.55,0.55],[11.6,4.2,1.2,1.2],[10.7,4.4,0.55,0.55],[13.15,4.4,0.55,0.55],[4,9.2,1.2,1.2],[3.1,9.399999999999999,0.55,0.55],[5.55,9.399999999999999,0.55,0.55],[8.4,9,1.2,1.2],[7.5,9.2,0.55,0.55],[9.950000000000001,9.2,0.55,0.55],[13,3.2,1.1,1.3]],"exit":[6,10.1,3,1.4],"spawn":[7.5,9.4],"npcs":[{"name":"U Tin Maung","skin":5,"role":"Tea shop owner","lines":["Laphet thoke or mohinga? Sit, sit. The plastic stools are the best seats in the city.","The tea is always hot here. Rain or alert, we stay open.","Students pay with smiles on exam week. Do not tell my accountant."],"x":8.6,"z":5.6}]},"hangar":{"w":24,"d":14,"colliders":[[0,0,24,3],[2,3.6,5,1.4],[17,3.6,5,1.4],[8.5,4.6,7,5.6],[1.4,9.4,1.6,1.6],[3.2,9.8,1.4,1.4],[20.6,9.4,1.6,1.6],[19,7,2.2,2.2],[20,11,2.4,1]],"exit":[10.5,13.1,3,1.4],"spawn":[12,12.4],"npcs":[{"name":"Engineer Daw Khin Lay","skin":3,"role":"Hangar chief","lines":["That is the school Frame. Eight metres of patience. We tune it every week.","Match the part to the slot. If it clicks, it is right. If it does not, it is also fine. Try the next one.","The sync ring glows on the roof when the machine is awake. Pretty, no?"],"x":16.7,"z":7.4}]},"workshop":{"w":16,"d":11,"colliders":[[0,0,16,3],[2,3.6,5,1.4],[9,3.6,5,1.4],[12.5,6.8,2.2,2.2],[1.6,8,1.6,1.6],[4,7.6,2.4,1],[7,6.4,3.6,3]],"exit":[6.5,10.1,3,1.4],"spawn":[8,9.4],"npcs":[{"name":"Ko Aung Naing","skin":2,"role":"Robot repair","lines":["A broken delivery drone, a rice cooker and a lamp. All fixed by Thursday.","Hold the part. Feel the weight. Machines are friendly when you listen."],"x":5.9,"z":6.5}]},"office":{"w":13,"d":10,"colliders":[[0,0,13,3],[1,0.6,3.4,1.2],[5,0.6,3.4,1.2],[1.6,4.2,3,1.4],[6.2,4.2,3,1.4],[10,4.8,2.2,1.4],[0.9,8,0.9,0.9],[5,8,3.2,1.2]],"exit":[5,9.1,3,1.4],"spawn":[6.5,8.4],"npcs":[{"name":"Daw Su Su Hlaing","skin":0,"role":"Administrator","lines":["Timetables, passes and lost umbrellas. This office handles all three.","Your allowance rises with your credits. Doing badly never ends anything here."],"x":6.8,"z":6.5}]},"clinic":{"w":14,"d":10,"colliders":[[0,0,14,3],[1,3.4,5,1.4],[8,3.4,2.2,3.2],[11,3.4,2.2,3.2],[1,7.2,3.2,1.2],[5,7.2,3.2,1.2],[12.6,8.2,0.9,0.9]],"exit":[5.5,9.1,3,1.4],"spawn":[7,8.4],"npcs":[{"name":"Dr. Ei Mon","skin":1,"role":"Student clinic nurse","lines":["A scraped knee, a headache or exam stress? All welcome. Tea first, then check-up.","After an incursion alert the clinic stays open late. People just like to talk."],"x":6.8,"z":5.6}]},"apartment":{"w":14,"d":10,"colliders":[[0,0,14,3],[1,4.4,3.2,1.2],[2.4,7.2,1.2,1.2],[8,3.6,5,1.4],[8.4,3.3,0.7,0.7],[11.4,6.2,2.2,3.2],[7.2,8.4,0.9,0.9],[8.6,0.8,4,1]],"exit":[5.5,9.1,3,1.4],"spawn":[7,8.4],"npcs":[{"name":"Ma Thida","skin":5,"role":"Neighbour","lines":["Four flights up and the lift is still slow. Good for the legs!","The rooftop garden has new orchids. Take a look if you pass the family cafe."],"x":6.8,"z":5.6}]},"family":{"w":16,"d":11,"colliders":[[0,0,16,3],[1,3.4,6,1.4],[1.4,3.1,0.7,0.7],[3,6.8,1.2,1.2],[2.1,7,0.55,0.55],[4.55,7,0.55,0.55],[8.4,4.4,3.2,1.2],[13.4,3.4,2.2,3.2],[12,0.8,3,1],[14.4,8.4,0.9,0.9],[6.4,9.2,1.2,1.2]],"exit":[6.5,10.1,3,1.4],"spawn":[8,9.4],"npcs":[{"name":"Mum (Daw Khin Khin)","skin":3,"role":"Your mother, runs the rooftop cafe","lines":["Good morning, little star. Eat something before class. There is tea on the counter.","The cafe is open on the terrace. Help if you like. If you are tired, rest. The regulars will wait.","Whatever happens outside the city, we are home here. Remember that."],"x":7.7,"z":6.5},{"name":"Grandpa U Ba Thein","skin":4,"role":"Your grandfather","lines":["In my day the sky was empty. Now it has trains, drones and little stars. I like it better.","Sit with me. The rain is coming. I can smell it."],"x":10.4,"z":6.5}]},"union":{"w":15,"d":11,"colliders":[[0,0,15,3],[1,4.6,3.2,1.2],[1,7,3.2,1.2],[5,5.4,2,1.6],[8.6,4.6,3.2,1.2],[8.2,7.4,2,1.6],[12.4,3.4,1.1,1.3],[13.2,8.6,0.9,0.9],[12,7,1.4,1.3]],"exit":[6,10.1,3,1.4],"spawn":[7.5,9.4],"npcs":[{"name":"Min Khant","skin":2,"role":"Union volunteer","lines":["Clubs meet here: robotics, tea, music and the star-watching society.","The festival needs stall helpers. Sign up, there is free mohinga."],"x":6.8,"z":3.8}]},"shop":{"w":12,"d":9,"colliders":[[0,0,12,3],[1,3.4,3.4,1.1],[5,3.4,3.4,1.1],[1,5.8,3.4,1.1],[5,5.8,3.4,1.1],[9,4,2.2,3.2],[10.6,0.9,0.9,0.9]],"exit":[4.5,8.1,3,1.4],"spawn":[6,7.4],"npcs":[]},"club":{"w":14,"d":10,"colliders":[[0,0,14,3],[1,3.2,1.4,1.3],[3,3.2,1.4,1.3],[5,3.2,1.4,1.3],[8,4.2,2,1.8],[8,7,2,1.8],[1,7.6,3.2,1.2],[12.6,8,0.9,0.9]],"exit":[5.5,9.1,3,1.4],"spawn":[7,8.4],"npcs":[{"name":"Htet Htet","skin":0,"role":"Arcade regular","lines":["High score on the left cabinet is mine. For now.","Losing is fine. The game says try again. Everything in this city says try again."],"x":6.8,"z":5.6}]},"sim":{"w":20,"d":14,"colliders":[[0,0,20,3],[1.5,3.4,2.6,3],[5.1,3.4,2.6,3],[8.7,3.4,2.6,3],[12.3,3.4,2.6,3],[15.9,3.4,2.6,3],[2,9.4,2,0.6],[6,9.4,2,0.6],[10,9.4,2,0.6],[14,9.4,2,0.6],[14.6,9.4,3.4,1.2],[18,12,0.9,0.9]],"exit":[8.5,13.1,3,1.4],"spawn":[10,12.4],"npcs":[{"name":"Instructor U Aung Thu","skin":4,"role":"Piloting instructor","lines":["Welcome to the simulator room. Nobody fails here. You just try again.","Today's exercise: walk the Frame through the wide checkpoints. Slow is fine.","Real deployments are handled by the adult defence corps. Until you are older, you train here, where it is safe."],"x":10.4,"z":7.4},{"name":"Ko Zin","skin":1,"role":"Classmate","lines":["My pod keeps showing a cyan ring. Is that the sync ring? I never remember.","If you get stuck on the checkpoints, follow my line. I will go slowly."],"x":7.7,"z":7.4}]},"warehouse":{"w":20,"d":12,"colliders":[[0,0,20,3],[2,4,2,2],[2.4,6.6,1.6,1.6],[6.4,4,2,2],[6.800000000000001,6.6,1.6,1.6],[10.8,4,2,2],[11.200000000000001,6.6,1.6,1.6],[15.200000000000001,4,2,2],[15.600000000000001,6.6,1.6,1.6],[15,9,2.4,1],[17.4,4.4,1.6,1.6]],"exit":[8.5,11.1,3,1.4],"spawn":[10,10.4],"npcs":[{"name":"Thura","skin":2,"role":"Dispatcher","lines":["Crates for the market, parcels for the dorms. The drones do the lifting, I do the shouting.","Cold storage is at the back. Mind the fish."],"x":9.5,"z":6.5}]},"market":{"w":24,"d":14,"colliders":[[0,0,24,3],[1.6,3.6,3.4,1.6],[6,3.6,3.4,1.6],[10.4,3.6,3.4,1.6],[14.8,3.6,3.4,1.6],[19.20000