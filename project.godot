; Engine configuration file.
; Godot 4 project for the cyberpunk Yangon RPG. See GameConcept.md and framework.md.

config_version=5

[application]

config/name="Cyberpunk Yangon"
config/description="Isometric pixel-art mech academy RPG set in a near-future Yangon."
run/main_scene="res://game/scenes/campus.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Game="*res://game/scripts/game_state.gd"
Shot="*res://game/scripts/screenshot.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.1, 0.11, 0.14, 1)
